# CurseForge / BigWigs packager (repo root — not inside GearQuest/).
# Docs: https://github.com/BigWigsMods/packager/wiki/Preparing-the-PackageMeta-File

package-as: GearQuest
enable-nolib-creation: no
manual-changelog: CHANGELOG.md

# Addon lives in GearQuest/ (not repo root); register that folder for TOC discovery.
move-folders:
  GearQuest: GearQuest

ignore:
  - .gitignore
  - .github
  - .cursor
  - README.md
  - CHANGELOG.md
  - RELEASE.md
  - docs
